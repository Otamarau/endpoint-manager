# Web server
PORT=3000
SITE_PASSCODE=replace-with-a-long-random-passcode

# RustDesk inventory (optional when ThreatDown is configured)
# Use an absolute path to the RustDesk Server Pro SQLite database.
RUSTDESK_DB_PATH=/absolute/path/to/rustdesk/data/db_v2.sqlite3

# ThreatDown inventory (optional when RustDesk is configured)
# All three values are required to enable the ThreatDown source.
THREATDOWN_CLIENT_ID=your-client-id
THREATDOWN_CLIENT_SECRET=your-client-secret
THREATDOWN_ACCOUNT_ID=your-account-id
